# =========================================================
# Copia este archivo como ".env" y completa tus datos reales.
# El archivo ".env" NUNCA debe subirse a un repositorio público.
# =========================================================

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=panaderia_db
DB_USER=root
DB_PASSWORD=

# --- Google OAuth ---
# Crear credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/callback

# --- Envío de correo (verificación de registro con Gmail) ---
# GMAIL_CORREO: la cuenta de Gmail que envía el código de verificación
# GMAIL_APP_PASSWORD: contraseña de aplicación (no la contraseña normal de la cuenta)
# Generarla en: https://myaccount.google.com/apppasswords
GMAIL_CORREO=
GMAIL_APP_PASSWORD=

# --- Configuración general ---
APP_ENV=development
